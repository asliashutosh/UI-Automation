# e6data platform configuration
E6DATA_BASE_URL=https://cp.uzumaki.me
E6DATA_USER_EMAIL=ashutosh@e6x.io
E6DATA_ORG_NAME=qa-test
E6DATA_SESSION_COOKIE=<jwt value>

# AWS credentials
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...
AWS_SESSION_TOKEN=...
AWS_REGION=us-east-1

# Reuse an existing workspace instead of creating a new one each run.
# Leave blank to auto-create a fresh workspace every run.
EXISTING_WORKSPACE=

# Test-specific parameters
TEST_BUCKET=670514002493-us-east-1-ashutosh-e6data
TEST_VPCE=vpce-0822d378a9e880c1e
TEST_ENGINE_ROLE_ARN=arn:aws:iam::908027423391:role/eb7aa9509f-us-east-1-brave-21-engine-access-role
TEST_STACK_NAME=playwright-auto-test
CREDENTIAL_NAME=playwright-test-cred

# Kubernetes (optional — leave blank to skip K8s tests)
# K8S_KUBECONFIG_PATH=~/.kube/config   # omit to use KUBECONFIG env var or in-cluster
# K8S_CONTEXT=my-cluster-context       # omit to use current context
K8S_NAMESPACE=default
K8S_ENGINE_DEPLOYMENT=e6data-engine

# Azure (optional — leave AZURE_SUBSCRIPTION_ID blank to skip Azure tests)
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_RESOURCE_GROUP=
AZURE_AKS_CLUSTER=
AZURE_STORAGE_ACCOUNT=
